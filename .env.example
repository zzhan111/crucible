# .env.example
# OpenAI 兼容 API key(支持 OpenAI 官方 / Azure / vLLM / 火山方舟等任意 OpenAI 格式 endpoint)
OPENAI_API_KEY=
# Base URL(默认 https://api.openai.com/v1,自建服务填自己的 URL)
OPENAI_BASE_URL=https://api.openai.com/v1
# 模型名(如 gpt-4o / deepseek-chat / 其他)
OPENAI_MODEL=gpt-4o

# 慢脑模型(可选)— 用于 Contract-Author 等"决策影响半径大"的调用
# 未设时自动降级到 OPENAI_MODEL,首次降级会打一行 warning
# OPENAI_MODEL_SLOW=deepseek-r1
